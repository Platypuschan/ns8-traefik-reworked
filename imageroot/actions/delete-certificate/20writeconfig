import json
import sys
import os
import cert_helpers
import agent
import datetime

def main():
    request = json.load(sys.stdin)
    if request['type'] == 'custom':
        old_names = cert_helpers.remove_custom_cert_by_path(request['path'])
        if not old_names:
            exit_certificate_not_found_error('path', request['path'])
        # Traefik keeps the removed certificate in its metrics until it
        # restarts, and ns8-metrics would raise expiry alerts for it.
        agent.run_helper("systemctl", "--user", "restart", "traefik")
    elif request['type'] == 'internal':
        if 'serial' in request:
            for dcert in cert_helpers.list_internal_certificates():
                if dcert['serial'] == request['serial']:
                    cert_helpers.clear_certresolver_in_http_routes(set(dcert['names']))
                    break
            else:
                exit_certificate_not_found_error('serial', request['serial'])
            old_names = cert_helpers.purge_acme_json_and_restart_traefik(purge_serial=request['serial'])
        elif request.get('obsolete') == True:
            old_names = cert_helpers.purge_acme_json_and_restart_traefik(purge_obsolete=True)
    json.dump({"certificate_names": list(old_names)}, fp=sys.stdout)

def exit_certificate_not_found_error(parameter, value):
    agent.set_status('validation-failed')
    json.dump([{'field': parameter,'parameter': parameter,'value': value,'error':'certificate_not_found'}], fp=sys.stdout)
    sys.exit(2)

if __name__ == "__main__":
    main()
